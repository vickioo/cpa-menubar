# Copy this file outside the repository and protect it with chmod 600.
CPA_DESKTOP_TOKEN=<YOUR_DESKTOP_TOKEN>
CPA_AUTH_DIR=/path/to/cliproxy-auth
CPA_CLIPROXY_URL=http://127.0.0.1:8317
# Set to sub2 to read only sanitized account metadata from PostgreSQL.
CPA_ACCOUNT_SOURCE=files
SUB2_DATABASE_URL=postgres://readonly_user:replace-me@sub2api-postgres/sub2api?sslmode=disable
SUB2_FOCUS_PRIORITY=80
SUB2_FOCUS_GROUP_IDS=
CPA_ROUTER_URL=http://127.0.0.1:8327
CPA_ROUTER_API_KEY=<YOUR_ROUTER_API_KEY>
XAI_MANAGEMENT_API_KEY=<YOUR_XAI_MANAGEMENT_KEY>
XAI_TEAM_ID=<YOUR_XAI_TEAM_ID>
